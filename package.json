{
  "name": "cv",
  "version": "1.0.0",
  "description": "Evidence-backed, deterministic CV generator for general and role-focused resumes.",
  "main": "src/cli.js",
  "scripts": {
    "cv": "node src/cli.js",
    "cv:generate": "node src/cli.js generate",
    "cv:validate": "node src/cli.js validate",
    "pdf": "node src/cli.js generate --format pdf",
    "pdf:legacy": "node scripts/generate-pdf.js",
    "pdf:install": "npx playwright install",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geiltonxavier/cv.git"
  },
  "keywords": [
    "resume",
    "cv",
    "playwright"
  ],
  "author": "Geilton Xavier",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/geiltonxavier/cv/issues"
  },
  "homepage": "https://github.com/geiltonxavier/cv#readme",
  "devDependencies": {
    "playwright": "^1.57.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "nunjucks": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
