{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical career data",
  "type": "object",
  "required": ["profile", "direct_sources", "experiences", "claims", "metrics", "education", "credentials", "conflicts", "review_queue", "tracks", "jobs"],
  "properties": {
    "profile": {
      "type": "object",
      "required": ["person", "contacts", "defaults", "evidence"],
      "properties": {
        "person": {
          "type": "object",
          "required": ["professional_name", "name_status", "source_ids"],
          "properties": {
            "professional_name": {"type": "string", "minLength": 1},
            "name_status": {"$ref": "#/$defs/status"},
            "source_ids": {"$ref": "#/$defs/sources"}
          },
          "additionalProperties": false
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "label", "value", "href", "status", "markets", "source_ids"],
            "properties": {
              "id": {"type": "string", "pattern": "^contact-[a-z0-9-]+$"},
              "kind": {"type": "string"},
              "label": {"type": "string"},
              "value": {"type": "string"},
              "href": {"type": "string"},
              "whatsapp": {"type": "boolean"},
              "status": {"$ref": "#/$defs/status"},
              "markets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["pt", "br"]}
              },
              "source_ids": {"$ref": "#/$defs/sources"},
              "conflict_ids": {"$ref": "#/$defs/conflictIds"}
            },
            "additionalProperties": false
          }
        },
        "defaults": {
          "type": "object",
          "required": ["language", "market", "track", "format"],
          "properties": {
            "language": {"enum": ["pt", "en"]},
            "market": {"enum": ["pt", "br"]},
            "track": {"type": "string"},
            "format": {"enum": ["html", "pdf", "all"]}
          },
          "additionalProperties": false
        },
        "evidence": {"type": "object"}
      },
      "additionalProperties": false
    },
    "direct_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "recorded_at", "statements"],
        "properties": {
          "id": {"type": "string", "pattern": "^USR-[0-9]{8}-[0-9]{3}$"},
          "kind": {"enum": ["user_confirmation"]},
          "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "statements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "experiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "evidence_id", "company", "role", "start", "end", "domains", "status", "source_ids", "conflict_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "evidence_id": {"type": "string", "pattern": "^EXP-[0-9]{3}$"},
          "company": {"type": "string", "minLength": 1},
          "role": {"$ref": "#/$defs/localized"},
          "start": {"$ref": "#/$defs/dateValue"},
          "end": {"$ref": "#/$defs/dateValue"},
          "location": {"$ref": "#/$defs/localized"},
          "domains": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["usable", "reference_only", "blocked"]},
          "source_ids": {"$ref": "#/$defs/sources"},
          "conflict_ids": {"$ref": "#/$defs/conflictIds"}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "experience_id", "text", "tags", "status", "confidence", "source_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLAIM-[0-9]{4}$"},
          "experience_id": {"type": "string"},
          "text": {"$ref": "#/$defs/localized"},
          "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "metric_ids": {"type": "array", "items": {"type": "string", "pattern": "^MET-[0-9]{3}$"}},
          "status": {"$ref": "#/$defs/status"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "source_ids": {"$ref": "#/$defs/sources"}
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "value", "unit", "context", "status", "confidence", "source_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^MET-[0-9]{3}$"},
          "value": {"oneOf": [{"type": "string"}, {"type": "number"}]},
          "unit": {"type": "string"},
          "context": {"type": "string"},
          "status": {"$ref": "#/$defs/status"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "source_ids": {"$ref": "#/$defs/sources"},
          "conflict_ids": {"$ref": "#/$defs/conflictIds"}
        },
        "additionalProperties": false
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "institution", "degree", "start", "end", "completion", "status", "source_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^EDU-[0-9]{3}$"},
          "institution": {"type": "string"},
          "degree": {"$ref": "#/$defs/localized"},
          "start": {"$ref": "#/$defs/dateValue"},
          "end": {"$ref": "#/$defs/dateValue"},
          "completion": {"enum": ["completed", "in_progress", "not_completed", "unknown"]},
          "status": {"$ref": "#/$defs/status"},
          "source_ids": {"$ref": "#/$defs/sources"},
          "conflict_ids": {"$ref": "#/$defs/conflictIds"}
        },
        "additionalProperties": false
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "institution", "name", "status", "source_ids"],
        "properties": {
          "id": {"type": "string"},
          "institution": {"type": "string"},
          "name": {"type": "string"},
          "type": {"type": "string"},
          "display_name": {"type": "string"},
          "year": {"type": "string"},
          "status": {"$ref": "#/$defs/status"},
          "source_ids": {"$ref": "#/$defs/sources"},
          "conflict_ids": {"$ref": "#/$defs/conflictIds"}
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "field", "status", "question"],
        "properties": {
          "id": {"type": "string", "pattern": "^CON-[0-9]{3}$"},
          "field": {"type": "string"},
          "status": {"enum": ["open", "resolved"]},
          "question": {"type": "string"},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review_queue": {
      "type": "object",
      "required": ["sources", "candidates"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "repository_path", "recovery_commit", "status", "note"],
            "properties": {
              "id": {"type": "string", "pattern": "^LEGACY-[A-Z0-9-]+$"},
              "repository_path": {"type": "string"},
              "recovery_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
              "status": {"enum": ["preserved_in_git_history"]},
              "note": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "statement", "status", "source_id", "reason"],
            "properties": {
              "id": {"type": "string", "pattern": "^LEGACY-CANDIDATE-[0-9]{3}$"},
              "kind": {"enum": ["contact", "claim", "technology", "context"]},
              "statement": {"$ref": "#/$defs/localized"},
              "status": {"enum": ["needs_confirmation", "blocked"]},
              "source_id": {"type": "string", "pattern": "^LEGACY-[A-Z0-9-]+$"},
              "related_experience_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/trackConfig"}
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jobConfig"}
    }
  },
  "$defs": {
    "trackProperties": {
      "type": "object",
      "properties": {
        "label": {"$ref": "#/$defs/localized"},
        "headline": {"$ref": "#/$defs/localized"},
        "subheadline": {"$ref": "#/$defs/localized"},
        "summary": {"$ref": "#/$defs/localized"},
        "summary_claim_ids": {"$ref": "#/$defs/claimIds"},
        "experience_claims": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{"$ref": "#/$defs/claimIds"}, {"const": "inherit"}]
          }
        },
        "page_break_before_experience": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "early_career_claim_ids": {"oneOf": [{"$ref": "#/$defs/claimIds"}, {"const": "inherit"}]},
        "target_pages": {"type": "integer", "minimum": 1, "maximum": 2},
        "skill_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "items", "evidence_claim_ids"],
            "properties": {
              "label": {"$ref": "#/$defs/localized"},
              "items": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "evidence_claim_ids": {"$ref": "#/$defs/claimIds"}
            },
            "additionalProperties": false
          }
        },
        "based_on": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "job": {"$ref": "#/$defs/jobMetadata"}
      },
      "additionalProperties": false
    },
    "trackConfig": {
      "type": "object",
      "$ref": "#/$defs/trackProperties",
      "required": ["label", "headline", "subheadline", "summary", "summary_claim_ids", "experience_claims", "early_career_claim_ids", "target_pages", "skill_groups"]
    },
    "jobConfig": {
      "allOf": [
        {"$ref": "#/$defs/trackProperties"},
        {"type": "object", "required": ["job"]}
      ]
    },
    "jobMetadata": {
      "type": "object",
      "required": ["company", "title"],
      "properties": {
        "company": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "location": {"type": "string"},
        "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "source": {"enum": ["pasted_text", "url", "pdf"]},
        "description_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "notes": {"type": "string"},
        "defaults": {
          "type": "object",
          "properties": {
            "language": {"enum": ["pt", "en"]},
            "market": {"enum": ["pt", "br"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "localized": {
      "type": "object",
      "required": ["pt", "en"],
      "properties": {
        "pt": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["usable", "needs_confirmation", "blocked"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(SRC-[0-9]{3}|USR-[0-9]{8}-[0-9]{3})$"}
    },
    "conflictIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CON-[0-9]{3}$"}
    },
    "claimIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CLAIM-[0-9]{4}$"}
    },
    "dateValue": {
      "oneOf": [
        {"type": "string", "pattern": "^(present|[0-9]{4}(-[0-9]{2})?)$"},
        {"type": "integer", "minimum": 1900, "maximum": 2200}
      ]
    }
  },
  "additionalProperties": false
}
